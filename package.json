{
  "name": "@groundhogchain/client",
  "version": "0.10.0",
  "description": "TypeScript client for the Groundhog blockchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groundhogchain/client-ts.git"
  },
  "homepage": "https://docs.groundhog.dev/tools/typescript-sdk/",
  "bugs": {
    "url": "https://github.com/groundhogchain/client-ts/issues"
  },
  "keywords": [
    "groundhog",
    "blockchain",
    "json-rpc",
    "sdk",
    "client"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js",
      "require": "./dist/transaction.cjs"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "require": "./dist/transport.cjs"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "require": "./dist/contract.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./signers": {
      "types": "./dist/signers.d.ts",
      "import": "./dist/signers.js",
      "require": "./dist/signers.cjs"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js",
      "require": "./dist/actions.cjs"
    },
    "./signed-op": {
      "types": "./dist/signed-op.d.ts",
      "import": "./dist/signed-op.js",
      "require": "./dist/signed-op.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js",
      "require": "./dist/wallet.cjs"
    },
    "./local-dev": {
      "types": "./dist/local-dev.d.ts",
      "import": "./dist/local-dev.js",
      "require": "./dist/local-dev.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "contracts:check": "./scripts/regenerate-contract-bindings.sh --check",
    "contracts:generate": "./scripts/regenerate-contract-bindings.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "test:package-boundary": "tsc -p scripts/tsconfig.package-boundary.json",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "example": "node scripts/run-example.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "25.9.1",
    "ajv": "8.20.0",
    "prettier": "3.8.3",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@groundhogchain/contract-spec": "0.11.0",
    "@groundhogchain/protocol": "0.11.0",
    "@groundhogchain/xdr": "0.11.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "smol-toml": "1.8.0"
  }
}
