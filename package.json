{
  "name": "@groundhogchain/client",
  "version": "0.1.4",
  "description": "TypeScript client for the Groundhog blockchain",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js",
      "require": "./dist/transaction.cjs"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "require": "./dist/transport.cjs"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "require": "./dist/contract.cjs"
    },
    "./signers": {
      "types": "./dist/signers.d.ts",
      "import": "./dist/signers.js",
      "require": "./dist/signers.cjs"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js",
      "require": "./dist/actions.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ajv": "^8.20.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@groundhogchain/contract-spec": "^0.4.0",
    "@groundhogchain/gateway": "^0.4.0",
    "@groundhogchain/protocol": "^0.4.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0"
  }
}
