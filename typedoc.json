{
  "name": "@thruputchain/client",
  "entryPoints": [
    "src/index.ts",
    "src/actions/index.ts",
    "src/transport/index.ts",
    "src/transaction/index.ts",
    "src/contract/index.ts",
    "src/contracts/index.ts",
    "src/signers/index.ts",
    "src/signedOp/index.ts",
    "src/provider/index.ts",
    "src/wallet/index.ts"
  ],
  "out": "docs/api",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "intentionallyNotExported": [
    "__gh_codegen.default_wallet$v0_1$$interface$WalletError",
    "__gh_codegen.groundhog_erc20_if$v0_1$error$ERC20Error",
    "__gh_codegen.groundhog_erc20_permit_if$v0_1$error$ERC20PermitError",
    "__gh_codegen.groundhog_signed_op_if$v0_1$error$SignedOpError"
  ],
  "cleanOutputDir": true,
  "githubPages": true,
  "treatWarningsAsErrors": true
}
